#!/bin/bash
set -euo pipefail

# chezmoi 実行時はシェルの profile が未読込の場合があるため brew を PATH に通す
if ! command -v brew >/dev/null 2>&1; then
    for brew in /opt/homebrew/bin/brew /usr/local/bin/brew /home/linuxbrew/.linuxbrew/bin/brew; do
        if [ -x "$brew" ]; then
            eval "$("$brew" shellenv)"
            break
        fi
    done
fi

if ! command -v brew >/dev/null 2>&1; then
    echo "warning: brew が見つからないためパッケージのインストールをスキップします" >&2
    exit 0
fi

brew bundle --file=/dev/stdin <<BREWFILE
{{ range .packages.brew -}}
brew {{ . | quote }}
{{ end -}}
BREWFILE
